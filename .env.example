# ─── Roll for Uptime — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# The app runs in supervisor-only mode if LLM vars are not set.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED: Change this to a long random string (32+ chars)
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/rfu.db

# ── File Storage ──────────────────────────────────────────────────────────────
# Directory where uploaded portraits are stored
UPLOADS_DIR=./uploads

# ── LLM / AI Game Master (optional) ──────────────────────────────────────────
# Leave blank to run in supervisor-only mode (human narrates all sessions)
#
# Provider options: openai | anthropic | ollama | custom
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
# For Ollama or any OpenAI-compatible endpoint:
# LLM_BASE_URL=http://localhost:11434/v1

# ── Image Generation (optional) ───────────────────────────────────────────────
# Enables AI portrait generation for operator files
# Provider options: openai | stability
IMAGE_PROVIDER=openai
IMAGE_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Set to "true" to require an invite code for new registrations
REQUIRE_INVITE=false

# ── CORS (development only) ───────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:5173
